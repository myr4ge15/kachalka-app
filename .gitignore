# Рабочая документация — закрытая: живет в приватном репозитории (pgit add -f, см. AGENTS.md и
# docs/guides/приватный-репо.md). В docs/ публичны только «Быстрый старт» и скриншоты README —
# остальное скрыто целиком (v6.16.0; раньше — списком имен, и часть доков была не прикрыта).
docs/*
!docs/quick-start.md
!docs/screenshots/
# архив (старое ТЗ, прежний CLAUDE.md) и кликабельные прототипы/мокапы — целиком
archive/
prototypes/
# локальный мусор в корне (старые скриншоты, вендорные бинарники)
debug/
deno/

# Настройка БД (схема, сид, RPC) и рабочие доки живут в ОТДЕЛЬНОМ ПРИВАТНОМ репозитории:
# этот публичный, а выкладывать RLS-политики, тела админских RPC и внутренние заметки
# живого приложения незачем. Инструкция — docs/guides/приватный-репо.md.
supabase/

# git-каталог того самого приватного репозитория (рабочая папка у них общая)
.private-git/

# CI приватного репозитория (тесты SQL на PGlite + Edge Functions на Deno) — лежит в общем
# .github/, но коммитится только туда (pgit add -f); публичному CI сервер недоступен.
.github/workflows/server-tests.yml

# разовый локальный генератор PNG-иконок (рецепт пересборки — в docs/PASPORT.md), в репо не нужен
scripts/gen-icons.mjs
